BASE_URL=https://api.openai.com/v1
API_KEY=your_api_key_here
MODEL_NAME=gpt-4.1-mini
OUTPUT_ROOT=outputs
TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=180
SUPPORT_VISION=true
TTS_BASE_URL=https://api.xiaomimimo.com/v1
TTS_API_KEY=your_mimo_api_key_here
TTS_MODEL_NAME=mimo-v2.5-tts
TTS_VOICE=mimo_default
TTS_AUDIO_FORMAT=wav
TTS_STYLE_PROMPT=请用自然、亲切、清晰的中文课堂讲解语气朗读，节奏平稳，重点适度强调。
TTS_MAX_WORKERS=4
DEBUG_DISABLE_VOICE=true
AUTH_SECRET=change_me_for_cookie_signing
ZX_AUTH_ISSUER_URL=https://oauth.722772.xyz
ZX_AUTH_CLIENT_ID=your_zx_auth_client_id
ZX_AUTH_CLIENT_SECRET=your_zx_auth_client_secret
ZX_AUTH_REDIRECT_URI=http://localhost:888/login/callback
ZX_AUTH_SCOPE=openid profile email
